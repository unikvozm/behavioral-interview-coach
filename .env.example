# Copy this file to .env.local for local development (Vercel CLI picks it up),
# and add the same key in your Vercel project settings for production.
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Create a new a Formspree form at https://formspree.io/ and use the endpoint here
FORMSPREE_ENDPOINT=https://formspree.io/f/your_formspree_endpoint_here
# Optional: Vercel project settings -> Git -> Deploy Hooks -> Create Hook.
# Lets you trigger a redeploy with `npm run redeploy` instead of a git push.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
